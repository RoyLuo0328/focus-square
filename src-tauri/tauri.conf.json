{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus Square 1.4",
  "version": "1.4.0",
  "identifier": "com.royluomac.focussquare",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Focus Square 1.4",
        "width": 260,
        "height": 260,
        "minWidth": 260,
        "minHeight": 260,
        "maxWidth": 420,
        "maxHeight": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "category": "Productivity",
    "shortDescription": "A local-first Pomodoro timer and focus analyzer",
    "longDescription": "Focus Square is a private, macOS-only Pomodoro timer with local reports and optional AI analysis.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
